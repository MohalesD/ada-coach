# Ada Coach — environment variables
# Copy to .env.local for local development. Never commit real values;
# .env* files are gitignored.

# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Supabase project URL and anon (publishable) key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Anon key again, unprefixed — used by node scripts (scripts/*.mjs).
SUPABASE_ANON_KEY=<anon-key>

# ── Local scripts only (optional) ────────────────────────────────────────
# Anthropic key for local experiments. Production Edge Functions do NOT
# read this file — see Supabase Secrets below.
ANTHROPIC_API_KEY=<anthropic-api-key>

# ── Supabase Secrets (server-side; never in any file in this repo) ───────
# Set with:  supabase secrets set KEY=value
#
#   ANTHROPIC_API_KEY   — chat, sessions (Haiku classifier + summary),
#                         assumption-mapping (Sonnet 4.6)
#   OPENAI_API_KEY      — ingest (text-embedding-3-small embeddings)
#   ALLOWED_ORIGINS     — comma-separated CORS allowlist,
#                         e.g. "http://localhost:5175,https://ada-coach.vercel.app"
#   SUPABASE_SERVICE_ROLE_KEY — auto-injected by Supabase; not set manually
